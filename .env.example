# Cloudflare R2 / AWS S3 Credentials for Modal Secret
# Create secret on Modal via:
#   modal secret create r2-credentials --from-dotenv .env
# or:
#   modal secret create r2-credentials R2_ENDPOINT_URL="..." AWS_ACCESS_KEY_ID="..." AWS_SECRET_ACCESS_KEY="..." BUCKET_NAME="..."

R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
AWS_ACCESS_KEY_ID=your_r2_or_aws_access_key
AWS_SECRET_ACCESS_KEY=your_r2_or_aws_secret_key
BUCKET_NAME=playground
INPUT_PREFIX=input/
OUTPUT_PREFIX=output/
